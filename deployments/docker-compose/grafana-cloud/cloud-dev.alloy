
// Use local module instead of git import to support custom API URL for dev stacks
// The module file is mounted at /etc/alloy/ in the container
import.file "grafana_cloud" {
  filename = "/etc/alloy/grafana_cloud_stack.alloy"
}

grafana_cloud.stack "receivers" {
  stack_name = env("GRAFANA_CLOUD_STACK")
  token = env("GRAFANA_CLOUD_TOKEN")
  // Use dev API URL - can be overridden via environment variable
  api_url = coalesce(env("GRAFANA_CLOUD_API_URL"), "https://grafana-dev.com/api/instances/")
}

import.file "backend" {
  filename = "/etc/alloy/backend_pipeline.alloy"
}

backend.pipeline "default" {
  metrics  = [grafana_cloud.stack.receivers.metrics]
  logs     = [grafana_cloud.stack.receivers.logs]
  profiles = [grafana_cloud.stack.receivers.profiles]
  otlp     = [otelcol.exporter.otlphttp.otlpEndpoint.input]
}

otelcol.auth.basic "otlpEndpoint" {
  // Grafana Cloud Instance ID.
  username = grafana_cloud.stack.receivers.info["id"]
  password = env("GRAFANA_CLOUD_TOKEN")
}

otelcol.exporter.otlphttp "otlpEndpoint" {
  client {
    // The OTLP gateway is named after the stack region (regionSlug), not its cluster (clusterSlug).
    // Set GRAFANA_CLOUD_OTLP_ENDPOINT to override, e.g. with the URL from the stack's OpenTelemetry tile.
    endpoint = coalesce(env("GRAFANA_CLOUD_OTLP_ENDPOINT"), "https://otlp-gateway-" + grafana_cloud.stack.receivers.info["regionSlug"] + ".grafana-dev.net/otlp")
    // https://github.com/grafana/beyla/blob/069049182455db603f3bda6865e7de13e45e038f/pkg/export/otel/common.go#L22
    auth     = otelcol.auth.basic.otlpEndpoint.handler
  }
}

